+def _branch_balance_adjustments(
+    diagnostics: pd.DataFrame | None,
+) -> tuple[pd.Series | None, set[str]]:
+    """Return net branch balances and raw-negative item codes from diagnostics."""
+    required = {"╪º┘ä┘â┘ê╪»", "Branch_Stock", "Pending_Purchases"}
+    if diagnostics is None or diagnostics.empty or not required.issubset(
+        diagnostics.columns
+    ):
+        return None, set()
+
+    source = diagnostics.loc[:, ["╪º┘ä┘â┘ê╪»", "Branch_Stock", "Pending_Purchases"]].copy()
+    source["_Code"] = _normalise_code_series(source["╪º┘ä┘â┘ê╪»"])
+    source = source.loc[source["_Code"].notna()].copy()
+    source["Branch_Stock"] = pd.to_numeric(
+        source["Branch_Stock"], errors="coerce"
+    ).fillna(0.0)
+    source["Pending_Purchases"] = pd.to_numeric(
+        source["Pending_Purchases"], errors="coerce"
+    ).fillna(0.0)
+    totals = source.groupby("_Code")[["Branch_Stock", "Pending_Purchases"]].sum()
+    net_balance = totals["Branch_Stock"] + totals["Pending_Purchases"]
+    negative_codes = set(totals.index[totals["Branch_Stock"] < 0].astype(str))
+    return net_balance, negative_codes
+
